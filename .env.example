# Frontend может работать с публичными API Bybit/Binance без ключей.
# Переменные ниже нужны ТОЛЬКО для ./deploy.sh:
# NETLIFY_AUTH_TOKEN=   # для цели netlify
# VERCEL_TOKEN=         # для цели vercel
#
# Дополнительно для deploy/vps_setup.sh (файл .env автоматически не читается):
# TWELVEDATA_API_KEY=   # первичная настройка или ротация ключа API акций
