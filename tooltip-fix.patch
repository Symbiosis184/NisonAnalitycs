+import { describe, it, expect, vi, beforeAll } from 'vitest';
+
+// jsdom не предоставляет ResizeObserver — заглушка для монтирования компонента
+beforeAll(() => {
+  (globalThis as any).ResizeObserver = class {
+    observe() {}
+    unobserve() {}
+    disconnect() {}
